<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sample launchd unit for the Condotto daemon (macOS, M4 §6).

  AUTH. Under API key auth — the default, and what you want if more than one
  person drives sessions — set ANTHROPIC_API_KEY in EnvironmentVariables below
  and `[auth] mode = "api_key"` in condotto.toml. Either unit type works.

  Under subscription auth (single operator driving their own sessions), install
  this as a per-user LaunchAgent (NOT a system LaunchDaemon): a LaunchAgent runs
  inside your logged-in GUI session, so the Claude Code SDK can reach the keychain
  OAuth credentials from your `claude` login — nothing to set below. (A
  LaunchDaemon runs before login without your keychain; if you must use one, set
  CLAUDE_CODE_OAUTH_TOKEN via `claude setup-token`.) See the README
  ("Authenticate Claude").

  Heads-up: a laptop that sleeps kills an actively-streaming turn (parked
  sessions survive on disk and resume). An always-on Mac — or a Linux box with
  the systemd unit — avoids that. See DESIGN.md §3 "Deployment shapes".

  INSTALL
    1. Put the release bundle somewhere stable and fill in condotto.toml beside it
       (chmod 600 condotto.toml — it holds your Slack tokens). A binary release is
       TWO files kept together: `condotto` and its `claude` sidecar.
         mkdir -p ~/condotto && cp dist/<platform>/{condotto,claude} ~/condotto/
         cp condotto.toml ~/condotto/ && chmod 600 ~/condotto/condotto.toml
    2. Edit the paths below (replace YOU / ~ expansions with absolute paths —
       launchd does NOT expand ~).
    3. Install + load:
         cp deploy/com.condotto.daemon.plist ~/Library/LaunchAgents/
         launchctl load  ~/Library/LaunchAgents/com.condotto.daemon.plist
         tail -f /Users/YOU/condotto/condotto.log      # watch the boot log
       To stop / reload after edits:
         launchctl unload ~/Library/LaunchAgents/com.condotto.daemon.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.condotto.daemon</string>

    <!-- The compiled binary + its `claude` sidecar in the same directory. To run
         from source, make this: bun, /Users/YOU/condotto/src/daemon.ts. Add a
         "--config" + path pair to point at a non-default config. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOU/condotto/condotto</string>
    </array>

    <!-- condotto.toml / condotto.sqlite live here; the `claude` sidecar sits beside
         the binary. Absolute path — launchd has no notion of ~ or $HOME here. -->
    <key>WorkingDirectory</key>
    <string>/Users/YOU/condotto</string>

    <!-- API key auth: uncomment and paste a Claude Console key (and set
         `[auth] mode = "api_key"` in condotto.toml).
         Subscription auth on a LaunchAgent: leave this alone — keychain OAuth
         needs nothing here. Subscription on a headless/LaunchDaemon setup: swap
         the key below for CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`.
         The daemon keeps whichever credential the agent runtime needs while
         scrubbing its own SLACK_*/CONDOTTO_* secrets out of the agent's shell. -->
    <!--
    <key>EnvironmentVariables</key>
    <dict>
        <key>ANTHROPIC_API_KEY</key>
        <string>REPLACE_WITH_KEY</string>
    </dict>
    -->

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on crash, but not on a clean operator-initiated stop. -->
    <key>KeepAlive</key>
    <dict>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/YOU/condotto/condotto.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOU/condotto/condotto.log</string>
</dict>
</plist>
