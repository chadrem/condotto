{
  "name": "conduit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/daemon.ts",
    "test": "bun test",
    "build": "bun run scripts/build-binary.ts",
    "build:darwin-arm64": "bun run scripts/build-binary.ts --target bun-darwin-arm64",
    "build:darwin-x64": "bun run scripts/build-binary.ts --target bun-darwin-x64",
    "build:linux-x64": "bun run scripts/build-binary.ts --target bun-linux-x64",
    "build:linux-arm64": "bun run scripts/build-binary.ts --target bun-linux-arm64",
    "check:ports": "bun run scripts/check-ports.ts",
    "smoke:create": "bun run scripts/smoke-create.ts",
    "smoke:resume": "bun run scripts/smoke-resume.ts",
    "smoke:gate": "bun run scripts/smoke-gate.ts",
    "smoke:approve": "bun run scripts/smoke-gate-approve.ts",
    "smoke:concurrency": "bun run scripts/smoke-concurrency.ts",
    "smoke:model": "bun run scripts/smoke-model.ts",
    "smoke:subagents": "bun run scripts/smoke-subagents.ts",
    "smoke:workflows": "bun run scripts/smoke-workflows.ts",
    "smoke:cancel": "bun run scripts/smoke-cancel.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.214",
    "@slack/bolt": "^4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
